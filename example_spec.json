{
  "version": "2.0",
  "metadata": {
    "description": "Example MeshNet with 5 decoders, dilations 16->8->4->2->1",
    "framework": "tinygrad",
    "input_shape": [1, 256, 256, 256],
    "output_classes": 2
  },
  "preprocessing": {
    "op": "qnormalize",
    "params": {
      "qmin": 0.02,
      "qmax": 0.98,
      "eps": 1e-3
    }
  },
  "forward_pass": [
    {"op": "conv3d", "params": {"in_channels": 1, "out_channels": 32, "kernel_size": 3, "padding": 16, "dilation": 16, "bias": false}},
    {"op": "group_norm", "params": {"num_groups": 32, "num_channels": 32, "affine": false}},
    {"op": "gelu", "params": {}},
    
    {"op": "conv3d", "params": {"in_channels": 32, "out_channels": 32, "kernel_size": 3, "padding": 8, "dilation": 8, "bias": false}},
    {"op": "group_norm", "params": {"num_groups": 32, "num_channels": 32, "affine": false}},
    {"op": "gelu", "params": {}},
    
    {"op": "conv3d", "params": {"in_channels": 32, "out_channels": 32, "kernel_size": 3, "padding": 4, "dilation": 4, "bias": false}},
    {"op": "group_norm", "params": {"num_groups": 32, "num_channels": 32, "affine": false}},
    {"op": "gelu", "params": {}},
    
    {"op": "conv3d", "params": {"in_channels": 32, "out_channels": 32, "kernel_size": 3, "padding": 2, "dilation": 2, "bias": false}},
    {"op": "group_norm", "params": {"num_groups": 32, "num_channels": 32, "affine": false}},
    {"op": "gelu", "params": {}},
    
    {"op": "conv3d", "params": {"in_channels": 32, "out_channels": 32, "kernel_size": 3, "padding": 1, "dilation": 1, "bias": false}},
    {"op": "group_norm", "params": {"num_groups": 32, "num_channels": 32, "affine": false}},
    {"op": "gelu", "params": {}},
    
    {"op": "conv3d", "params": {"in_channels": 32, "out_channels": 2, "kernel_size": 1, "padding": 0, "dilation": 1, "bias": false}}
  ],
  "postprocessing": {
    "op": "none",
    "params": {}
  }
}